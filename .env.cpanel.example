# Copy to .env on the cPanel server (never commit real secrets).
# Prefer MultiPHP Manager → PHP 8.3+ with: pdo_pgsql (or pdo_mysql), mbstring, openssl, tokenizer, xml, ctype, json, bcmath, fileinfo, gd, zip

APP_NAME="SaaS LeadFlow"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Dhaka

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Supabase Postgres (requires pdo_pgsql on cPanel). Switch to mysql if your host has no pgsql.
DB_CONNECTION=pgsql
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=change_me_db_password
DB_SSLMODE=require

# cPanel usually has no Redis — use database drivers
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

N8N_LEAD_SEARCH_WEBHOOK_URL=
N8N_EMAIL_PROCESS_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_HTTP_TIMEOUT=300
EMAIL_OUTREACH_WEBHOOK_URL=

ADMIN_NAME="System Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common
AZURE_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"
GRAPH_WEBHOOK_URL="${APP_URL}/webhooks/graph/notifications"

MATON_API_KEY=
